FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client-16 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "boto3>=1.40,<2" "cryptography>=44,<48"
RUN groupadd --gid 10001 s4p && useradd --uid 10001 --gid 10001 --create-home s4p
COPY --chown=10001:10001 scripts/s4p_backup.py /app/s4p_backup.py
USER 10001:10001
CMD ["python", "/app/s4p_backup.py", "backup"]
