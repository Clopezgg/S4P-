FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api VITE_S4P_INITIAL_THEME_ID=s4p-horizon-light
RUN npm run build

FROM python:3.12-slim-trixie
WORKDIR /app
# Debian Trixie ships PostgreSQL 17 client, compatible with Render PG16.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 FRONTEND_DIST_DIR=/app/frontend-dist
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --gid 10001 s4p \
    && useradd --uid 10001 --gid 10001 --create-home s4p
COPY --chown=10001:10001 backend/ ./
COPY --chown=10001:10001 scripts/s4p_backup.py /app/s4p_backup.py
COPY --from=frontend --chown=10001:10001 /build/dist /app/frontend-dist
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('PORT', '8000') + '/api/healthz', timeout=5).close()"
CMD ["sh", "-c", "alembic upgrade head && if [ \"${EVIDENCE_BACKEND:-none}\" = \"supabase_edge\" ]; then python verify_evidence_storage.py; fi && exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
